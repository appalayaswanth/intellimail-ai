# IntelliMail AI Environment Configuration

# Optional: Google Gemini API Key for dynamic LLM email generation
# If left blank, the system automatically runs in high-quality Demo Heuristic Mode
GEMINI_API_KEY=

# Optional: Brevo (Sendinblue) Transactional API Key for real email dispatch
# If left blank, the system operates in probabilistic Simulation Mode
BREVO_API_KEY=

# Default Sender Information (Used if Brevo is configured)
SENDER_NAME=IntelliMail AI Marketing
SENDER_EMAIL=marketing@example.com
